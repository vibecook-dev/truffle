// Seams with several anchors are declared here. Contracts with one anchor are declared in-code at their trait or
// enum: network-provider (NetworkProvider), envelope-codec (EnvelopeCodec), store-backend (StoreBackend), ft-wire
// (FtMessage) and sync-wire (SyncMessage).

contract transport-traits "Layer 4 transport trait families" {
  intent "Framed streams (WebSocket, QUIC), raw byte streams (TCP) and datagrams (UDP); Layer 5 consumes FramedStream."
  at sym:truffle_core::transport::{StreamTransport, FramedStream, RawTransport, DatagramTransport}
  implemented-by crate:truffle-core
  see "docs/rfcs/012-layered-architecture-redesign.md#34-layer-4-transport"
}

contract napi-projection "The key types every binding bridges, as NAPI exports" {
  intent "RFC 015's list of types to bridge; each has a Napi-prefixed export in the generated index.d.ts."
  at sym:truffle_core::{Peer, NamespacedMessage, FileOffer, FileTransferEvent, TransferResult}
  at sym:truffle_core::session::PeerEvent, sym:truffle_core::network::{NodeIdentity, PingResult}
  mirror "crates/truffle-napi/index.d.ts#Napi{name}"
  note file:crates/truffle-napi/index.d.ts "Generated by NAPI-RS; the pre-commit hook rebuilds it and blocks a commit whose copy is stale."
  see "docs/rfcs/015-binding-rewrite.md#3-current-node-api-what-bindings-must-wrap"
  see "CLAUDE.md#pre-commit-hook-one-time-setup-per-clone"
}

contract session-wire "Session wire contract: hello v2 and the JSON envelope" {
  intent "Both engines speak it verbatim; the wire `from` is never trusted, the receiver stamps the WhoIs-verified id."
  at sym:truffle_core::Envelope, sym:truffle_core::session::hello::HelloEnvelope
  note file:apple/Sources/Truffle/Wire/Envelope.swift, file:apple/Sources/Truffle/Wire/HelloEnvelope.swift "The Swift mirrors, field for field."
  note path:apple/Tests/TruffleTests/Fixtures/ "Shared fixtures, decoded by WireTests.swift and by crates/truffle-core/tests/interop_fixtures.rs."
  see "docs/rfcs/024-truffle-swift.md#81-session-protocol-as-shipped"
  see "apple/README.md#wire-compatibility-rfc-024-8"
}

contract bench-app-types "The RFC 027 §7 fixture types, mirrored by hand in TypeScript" {
  intent "Rust is the source of truth (benchmark/schema is generated from it); app/src/api/types.ts is hand-written, and fixtures.test.ts type-checks every fixture against it."
  at sym:truffle_bench::types::{HubEvent, NodeState, Progress, RunSummary, AppInfo, Settings, BenchPeer, PeerProbe, SuiteProfile}
  at sym:truffle_bench::params::WorkloadParams, sym:truffle_bench::report::RunReport, sym:truffle_bench::error::AppError
  mirror "benchmark/app/src/api/types.ts#{name}"
  see "docs/rfcs/027-benchmark-hub.md#7-types-shared-with-the-app"
  see "benchmark/README.md#reports"
}
