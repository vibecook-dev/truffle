{
  "name": "@vibecook/truffle-root",
  "private": true,
  "version": "0.1.0",
  "description": "Standalone mesh networking library built on Tailscale",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibecook-dev/truffle.git"
  },
  "homepage": "https://github.com/vibecook-dev/truffle#readme",
  "bugs": {
    "url": "https://github.com/vibecook-dev/truffle/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.20.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:rust": "TRUFFLE_TEST_AUTHKEY= TS_AUTHKEY= TRUFFLE_BENCH_AUTH_KEY= cargo test --locked --workspace --exclude truffle-bench-app",
    "test:real": "cargo test --locked -p truffle-core --tests -- --nocapture",
    "test:all": "pnpm run test && pnpm run test:rust",
    "bench": "pnpm run bench:micro",
    "bench:micro": "CRITERION_HOME=\"$PWD/target/criterion\" cargo bench --locked -p truffle-core",
    "bench:suite": "cargo run --locked -p truffle-bench --release -- suite --profile standard --pair",
    "bench:pair": "cargo run --locked -p truffle-bench --release -- pair",
    "run-all": "bash scripts/run-all-tests-and-benches.sh",
    "run-all:fast": "bash scripts/run-all-tests-and-benches.sh --fast",
    "build:sidecar": "cd packages/sidecar-slim && go build -o ../../crates/truffle-core/tests/test-sidecar .",
    "check:secrets": "bash scripts/check-for-secrets.sh",
    "clean": "pnpm -r run clean && rm -f packages/*/tsconfig.tsbuildinfo",
    "clean:bench": "rm -rf target/criterion target/bench-results",
    "typecheck": "pnpm run build",
    "lint": "eslint '{packages/*/src,benchmark/app/src}/**/*.{ts,tsx}'",
    "lint:fix": "eslint '{packages/*/src,benchmark/app/src}/**/*.{ts,tsx}' --fix",
    "format": "prettier --write '{packages/*/src,benchmark/app/src}/**/*.{ts,tsx}'",
    "format:check": "prettier --check '{packages/*/src,benchmark/app/src}/**/*.{ts,tsx}'",
    "release:prepare": "node scripts/sync-release-locks.mjs",
    "release:check": "node scripts/sync-release-locks.mjs --check && node scripts/check-release-versions.mjs --allow-missing-checksums",
    "release:tooling:test": "node --test scripts/*.test.mjs",
    "release:verify": "node scripts/sync-release-locks.mjs --check && node scripts/check-release-versions.mjs && cargo metadata --locked --no-deps --format-version 1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.4"
  }
}
