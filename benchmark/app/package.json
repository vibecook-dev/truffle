{
  "name": "@vibecook/truffle-bench-app",
  "private": true,
  "version": "0.0.0",
  "description": "truffle bench: the desktop app that measures truffle between your own machines (RFC 027)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:dev:release": "tauri dev --release",
    "app:sidecar": "node scripts/prepare-sidecar.mjs",
    "app:build": "node scripts/prepare-sidecar.mjs --tauri build --config src-tauri/tauri.bundle.conf.json",
    "app:build:universal": "node scripts/prepare-sidecar.mjs --universal --tauri build --target universal-apple-darwin --config src-tauri/tauri.bundle.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^5.8.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.4"
  }
}
