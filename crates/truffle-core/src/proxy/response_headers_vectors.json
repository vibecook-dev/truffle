{
  "spec": "docs/rfcs/030-serve-response-headers.md",
  "about": "Response-header validation vectors (RFC 030). truffle-core's validate_config (crates/truffle-core/src/proxy/mod.rs) and the sidecar's validateResponseHeaders (packages/sidecar-slim/main.go) are both tested against every case. A case's serve list (plus serveFill) is the serve's headers; a route list or routeFill puts them on one route {prefix: \"/\", dir: \"/srv\"}. repeat N makes the value its unit repeated N times; fill {prefix, count} appends headers prefix1..prefixN, each with the value \"v\". error is a substring both implementations' messages contain.",
  "bounds": {"maxHeaders": 32, "maxNameBytes": 64, "maxValueBytes": 8192, "maxListBytes": 16384},
  "refused": ["connection", "keep-alive", "te", "trailer", "transfer-encoding", "upgrade", "set-cookie", "content-length", "host", "proxy-*"],
  "cases": [
    {"id": "serve-policy-headers", "serve": [{"name": "Content-Security-Policy", "value": "default-src 'self'; frame-ancestors 'none'"}, {"name": "Referrer-Policy", "value": "no-referrer"}, {"name": "Permissions-Policy", "value": "camera=(), microphone=()"}], "ok": true},
    {"id": "route-policy-headers", "route": [{"name": "X-Frame-Options", "value": "DENY"}, {"name": "Cross-Origin-Opener-Policy", "value": "same-origin"}], "ok": true},
    {"id": "route-replaces-serve-name", "serve": [{"name": "X-Frame-Options", "value": "DENY"}], "route": [{"name": "x-frame-options", "value": "SAMEORIGIN"}], "ok": true},
    {"id": "value-inner-space-and-tab", "serve": [{"name": "X-Note", "value": "a\tb c"}], "ok": true},
    {"id": "value-visible-punctuation", "serve": [{"name": "Content-Security-Policy", "value": "script-src 'sha256-ab+/=' \"x\" \\ ~"}], "ok": true},
    {"id": "every-tchar-in-name", "serve": [{"name": "X-!#$%&'*+-.^_`|~09aZ", "value": "v"}], "ok": true},
    {"id": "lookalike-names", "serve": [{"name": "Proxy", "value": "v"}, {"name": "X-Upgrade", "value": "v"}, {"name": "Hosts", "value": "v"}, {"name": "Te-Policy", "value": "v"}], "ok": true},
    {"id": "name-at-64-bytes", "serve": [{"name": "X-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "value": "v"}], "ok": true},
    {"id": "value-at-8192-bytes", "serve": [{"name": "X-Big", "value": "a", "repeat": 8192}], "ok": true},
    {"id": "count-at-32", "serveFill": {"prefix": "X-Serve-", "count": 32}, "ok": true},
    {"id": "route-count-at-32-after-merge", "serveFill": {"prefix": "X-Serve-", "count": 20}, "routeFill": {"prefix": "X-Route-", "count": 12}, "ok": true},
    {"id": "route-replacing-serve-names-is-not-counted-twice", "serveFill": {"prefix": "X-Serve-", "count": 20}, "routeFill": {"prefix": "x-serve-", "count": 13}, "ok": true},
    {"id": "list-bytes-at-16384", "serve": [{"name": "X-A", "value": "a", "repeat": 8192}, {"name": "X-B", "value": "b", "repeat": 8186}], "ok": true},
    {"id": "route-replacing-serve-name-is-not-sized-twice", "serve": [{"name": "X-A", "value": "a", "repeat": 8192}], "route": [{"name": "x-a", "value": "b", "repeat": 8192}], "ok": true},
    {"id": "refused-serve-Connection", "serve": [{"name": "Connection", "value": "x"}], "ok": false, "error": "cannot be configured"},
    {"id": "refused-serve-keep-alive", "serve": [{"name": "keep-alive", "value": "x"}], "ok": false, "error": "cannot be configured"},
    {"id": "refused-serve-Keep-Alive", "serve": [{"name": "Keep-Alive", "value": "x"}], "ok": false, "error": "cannot be configured"},
    {"id": "refused-serve-Proxy-Authenticate", "serve": [{"name": "Proxy-Authenticate", "value": "x"}], "ok": false, "error": "cannot be configured"},
    {"id": "refused-serve-proxy-connection", "serve": [{"name": "proxy-connection", "value": "x"}], "ok": false, "error": "cannot be configured"},
    {"id": "refused-serve-Proxy-Authorization", "serve": [{"name": "Proxy-Authorization", "value": "x"}], "ok": false, "error": "cannot be configured"},
    {"id": "refused-serve-PROXY-Anything", "serve": [{"name": "PROXY-Anything", "value": "x"}], "ok": false, "error": "cannot be configured"},
    {"id": "refused-serve-TE", "serve": [{"name": "TE", "value": "x"}], "ok": false, "error": "cannot be configured"},
    {"id": "refused-serve-Trailer", "serve": [{"name": "Trailer", "value": "x"}], "ok": false, "error": "cannot be configured"},
    {"id": "refused-serve-Transfer-Encoding", "serve": [{"name": "Transfer-Encoding", "value": "x"}], "ok": false, "error": "cannot be configured"},
    {"id": "refused-serve-Upgrade", "serve": [{"name": "Upgrade", "value": "x"}], "ok": false, "error": "cannot be configured"},
    {"id": "refused-serve-Set-Cookie", "serve": [{"name": "Set-Cookie", "value": "x"}], "ok": false, "error": "cannot be configured"},
    {"id": "refused-serve-set-cookie", "serve": [{"name": "set-cookie", "value": "x"}], "ok": false, "error": "cannot be configured"},
    {"id": "refused-serve-Content-Length", "serve": [{"name": "Content-Length", "value": "x"}], "ok": false, "error": "cannot be configured"},
    {"id": "refused-serve-Host", "serve": [{"name": "Host", "value": "x"}], "ok": false, "error": "cannot be configured"},
    {"id": "refused-serve-HOST", "serve": [{"name": "HOST", "value": "x"}], "ok": false, "error": "cannot be configured"},
    {"id": "refused-route-connection", "route": [{"name": "Connection", "value": "x"}], "ok": false, "error": "cannot be configured"},
    {"id": "refused-route-set-cookie", "route": [{"name": "Set-Cookie", "value": "x"}], "ok": false, "error": "cannot be configured"},
    {"id": "refused-route-proxy-x", "route": [{"name": "Proxy-X", "value": "x"}], "ok": false, "error": "cannot be configured"},
    {"id": "refused-route-host", "route": [{"name": "host", "value": "x"}], "ok": false, "error": "cannot be configured"},
    {"id": "name-empty", "serve": [{"name": "", "value": "v"}], "ok": false, "error": "is not an RFC 7230 token"},
    {"id": "name-space", "serve": [{"name": "a b", "value": "v"}], "ok": false, "error": "is not an RFC 7230 token"},
    {"id": "name-colon", "serve": [{"name": "a:b", "value": "v"}], "ok": false, "error": "is not an RFC 7230 token"},
    {"id": "name-slash", "serve": [{"name": "a/b", "value": "v"}], "ok": false, "error": "is not an RFC 7230 token"},
    {"id": "name-comma", "serve": [{"name": "a,b", "value": "v"}], "ok": false, "error": "is not an RFC 7230 token"},
    {"id": "name-quote", "serve": [{"name": "a\"b", "value": "v"}], "ok": false, "error": "is not an RFC 7230 token"},
    {"id": "name-parens", "serve": [{"name": "(comment)", "value": "v"}], "ok": false, "error": "is not an RFC 7230 token"},
    {"id": "name-non-ascii", "serve": [{"name": "R\u00e9ferer", "value": "v"}], "ok": false, "error": "is not an RFC 7230 token"},
    {"id": "name-crlf-injection", "serve": [{"name": "X-Bad\r\nInjected", "value": "v"}], "ok": false, "error": "is not an RFC 7230 token"},
    {"id": "name-route-space", "route": [{"name": "a b", "value": "v"}], "ok": false, "error": "is not an RFC 7230 token"},
    {"id": "name-65-bytes", "serve": [{"name": "X-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "value": "v"}], "ok": false, "error": "is longer than 64 bytes"},
    {"id": "value-empty", "serve": [{"name": "X-Empty", "value": ""}], "ok": false, "error": "has an empty value"},
    {"id": "value-8193-bytes", "serve": [{"name": "X-Big", "value": "a", "repeat": 8193}], "ok": false, "error": "value is longer than 8192 bytes"},
    {"id": "value-cr", "serve": [{"name": "X-V", "value": "a\rb"}], "ok": false, "error": "a byte other than VCHAR, SP or HTAB"},
    {"id": "value-lf", "serve": [{"name": "X-V", "value": "a\nb"}], "ok": false, "error": "a byte other than VCHAR, SP or HTAB"},
    {"id": "value-crlf-injection", "serve": [{"name": "X-V", "value": "a\r\nSet-Cookie: s=1"}], "ok": false, "error": "a byte other than VCHAR, SP or HTAB"},
    {"id": "value-nul", "serve": [{"name": "X-V", "value": "a\u0000b"}], "ok": false, "error": "a byte other than VCHAR, SP or HTAB"},
    {"id": "value-del", "serve": [{"name": "X-V", "value": "a\u007fb"}], "ok": false, "error": "a byte other than VCHAR, SP or HTAB"},
    {"id": "value-control", "serve": [{"name": "X-V", "value": "a\u001bb"}], "ok": false, "error": "a byte other than VCHAR, SP or HTAB"},
    {"id": "value-non-ascii", "serve": [{"name": "X-V", "value": "caf\u00e9"}], "ok": false, "error": "a byte other than VCHAR, SP or HTAB"},
    {"id": "value-route-lf", "route": [{"name": "X-V", "value": "x\ny"}], "ok": false, "error": "a byte other than VCHAR, SP or HTAB"},
    {"id": "value-leading-space", "serve": [{"name": "X-V", "value": " a"}], "ok": false, "error": "leading or trailing whitespace"},
    {"id": "value-trailing-space", "serve": [{"name": "X-V", "value": "a "}], "ok": false, "error": "leading or trailing whitespace"},
    {"id": "value-leading-tab", "serve": [{"name": "X-V", "value": "\ta"}], "ok": false, "error": "leading or trailing whitespace"},
    {"id": "value-trailing-tab", "serve": [{"name": "X-V", "value": "a\t"}], "ok": false, "error": "leading or trailing whitespace"},
    {"id": "value-only-space", "serve": [{"name": "X-V", "value": " "}], "ok": false, "error": "leading or trailing whitespace"},
    {"id": "duplicate-serve-case-insensitive", "serve": [{"name": "X-Frame-Options", "value": "DENY"}, {"name": "x-frame-options", "value": "SAMEORIGIN"}], "ok": false, "error": "appears twice"},
    {"id": "duplicate-route-case-insensitive", "route": [{"name": "Content-Security-Policy", "value": "a"}, {"name": "content-security-policy", "value": "b"}], "ok": false, "error": "appears twice"},
    {"id": "count-33-serve", "serveFill": {"prefix": "X-Serve-", "count": 33}, "ok": false, "error": "more than 32 response headers"},
    {"id": "count-33-route", "routeFill": {"prefix": "X-Route-", "count": 33}, "ok": false, "error": "more than 32 response headers"},
    {"id": "count-33-after-merge", "serveFill": {"prefix": "X-Serve-", "count": 20}, "routeFill": {"prefix": "X-Route-", "count": 13}, "ok": false, "error": "more than 32 response headers"},
    {"id": "bytes-over-serve", "serve": [{"name": "X-A", "value": "a", "repeat": 8192}, {"name": "X-B", "value": "b", "repeat": 8187}], "ok": false, "error": "exceed 16384 bytes"},
    {"id": "bytes-over-two-full-values", "serve": [{"name": "X-A", "value": "a", "repeat": 8192}, {"name": "X-B", "value": "b", "repeat": 8192}], "ok": false, "error": "exceed 16384 bytes"},
    {"id": "bytes-over-after-merge", "serve": [{"name": "X-A", "value": "a", "repeat": 8192}], "route": [{"name": "X-B", "value": "b", "repeat": 8192}], "ok": false, "error": "exceed 16384 bytes"}
  ]
}
