diff --git a/remote_address_test.go b/remote_address_test.go
new file mode 100644
index 0000000..2e5c862
--- /dev/null
+++ b/remote_address_test.go
@@ -0,0 +1,239 @@
+package main
+
+import (
+	"encoding/binary"
+	"fmt"
+	"io"
+	"net"
+	"syscall"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+func testSocketPair(t *testing.T) [2]int {
+	t.Helper()
+	pair, err := syscall.Socketpair(syscall.AF_LOCAL, syscall.SOCK_STREAM, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { syscall.Close(pair[0]); syscall.Close(pair[1]) })
+	return pair
+}
+
+func TestQueuedConnectionsKeepRemoteIdentityAfterFDReuse(t *testing.T) {
+	control := testSocketPair(t)
+	ln := &listener{fd: control[1]}
+	defer ln.closePending()
+	source, err := syscall.Dup(control[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer syscall.Close(source)
+	const count = 8
+	want := make([]net.Addr, count)
+	for i := range count {
+		pair := testSocketPair(t)
+		// Deterministically reuse the sender descriptor while previous
+		// SCM_RIGHTS references remain queued and none have been accepted.
+		if err := syscall.Dup2(pair[0], source); err != nil {
+			t.Fatal(err)
+		}
+		ip := fmt.Sprintf("100.64.0.%d", i+1)
+		if i%2 != 0 {
+			ip = fmt.Sprintf("fd7a:115c:a1e0::%x", i+1)
+		}
+		want[i] = &net.TCPAddr{IP: net.ParseIP(ip), Port: 12345 + i}
+		if err := ln.sendConn(source, want[i]); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := syscall.Write(pair[1], []byte{byte(i)}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	var received []int
+	for range count {
+		fd, err := ln.acceptConn(control[0])
+		if err != nil {
+			t.Fatal(err)
+		}
+		received = append(received, fd)
+		defer syscall.Close(fd)
+	}
+	// Delay all lookups until after all accepts to exercise both maps.
+	for i, fd := range received {
+		addr, ok := ln.takeRemoteAddr(fd)
+		if !ok || addr.String() != want[i].String() {
+			t.Fatalf("connection %d: got %v, want %v", i, addr, want[i])
+		}
+		var payload [1]byte
+		if n, err := syscall.Read(fd, payload[:]); err != nil || n != 1 || payload[0] != byte(i) {
+			t.Fatalf("connection %d: wrong socket payload %v (n=%d, err=%v)", i, payload, n, err)
+		}
+		if _, ok := ln.takeRemoteAddr(fd); ok {
+			t.Fatal("remote address was not consumed")
+		}
+	}
+	if len(ln.pending) != 0 || len(ln.m) != 0 {
+		t.Fatal("remote address entries leaked")
+	}
+}
+
+func TestAcceptReadsSplitTransferToken(t *testing.T) {
+	control := testSocketPair(t)
+	conn := testSocketPair(t)
+	want := &net.TCPAddr{IP: net.ParseIP("100.64.0.2"), Port: 12345}
+	heldFD, err := syscall.Dup(conn[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	ln := &listener{pending: map[uint64]pendingConn{42: {addr: want, fd: heldFD}}}
+	defer ln.closePending()
+	var payload [8]byte
+	binary.BigEndian.PutUint64(payload[:], 42)
+	if err := syscall.Sendmsg(control[1], payload[:1], syscall.UnixRights(conn[0]), nil, 0); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := syscall.Write(control[1], payload[1:]); err != nil {
+		t.Fatal(err)
+	}
+	fd, err := ln.acceptConn(control[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer syscall.Close(fd)
+	if addr, ok := ln.takeRemoteAddr(fd); !ok || addr.String() != want.String() {
+		t.Fatalf("got %v, want %v", addr, want)
+	}
+}
+
+func TestFailedTransferDoesNotKeepRemoteAddress(t *testing.T) {
+	conn := testSocketPair(t)
+	ln := &listener{fd: -1}
+	if err := ln.sendConn(conn[0], &net.TCPAddr{}); err == nil {
+		t.Fatal("send on invalid FD succeeded")
+	}
+	if len(ln.pending) != 0 {
+		t.Fatal("failed transfer leaked remote address")
+	}
+}
+
+func TestListenerCloseReleasesPendingSockets(t *testing.T) {
+	control := testSocketPair(t)
+	conn := testSocketPair(t)
+	ln := &listener{fd: control[1]}
+	if err := ln.sendConn(conn[0], &net.TCPAddr{}); err != nil {
+		t.Fatal(err)
+	}
+	var held []int
+	for _, pending := range ln.pending {
+		held = append(held, pending.fd)
+	}
+	ln.closePending()
+	ln.closePending() // cleanup may be called by either listener goroutine
+	for _, fd := range held {
+		if _, err := unix.FcntlInt(uintptr(fd), unix.F_GETFD, 0); err != unix.EBADF {
+			t.Fatalf("pending descriptor %d still open after listener close: %v", fd, err)
+		}
+	}
+	if err := ln.sendConn(conn[0], &net.TCPAddr{}); err != net.ErrClosed {
+		t.Fatalf("send after listener close = %v, want net.ErrClosed", err)
+	}
+}
+
+func TestQueuedConnectionPumpsSurviveReuseAndCleanUp(t *testing.T) {
+	control := testSocketPair(t)
+	ln := &listener{fd: control[1]}
+	defer ln.closePending()
+	var peers []net.Conn
+	var received []int
+	defer func() {
+		for _, fd := range received {
+			syscall.Close(fd)
+		}
+		for _, peer := range peers {
+			peer.Close()
+		}
+		// Ensure the two copy pumps finish, including the concurrent
+		// shutdown/close path checked by the race detector.
+		deadline := time.Now().Add(time.Second)
+		for {
+			conns.mu.Lock()
+			remaining := len(conns.m)
+			conns.mu.Unlock()
+			if remaining == 0 {
+				return
+			}
+			if time.Now().After(deadline) {
+				t.Errorf("%d connection pumps leaked", remaining)
+				return
+			}
+			time.Sleep(time.Millisecond)
+		}
+	}()
+	for i := range 8 {
+		a, b := net.Pipe()
+		peers = append(peers, b)
+		fd, err := newConn(&server{}, a)
+		if err != nil {
+			a.Close()
+			t.Fatal(err)
+		}
+		if err := ln.sendConn(fd, &net.TCPAddr{IP: net.ParseIP("100.64.0.2"), Port: i}); err != nil {
+			syscall.Close(fd)
+			t.Fatal(err)
+		}
+		syscall.Close(fd)
+		b.SetWriteDeadline(time.Now().Add(time.Second))
+		if _, err := b.Write([]byte{byte(i)}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for i := range 8 {
+		fd, err := ln.acceptConn(control[0])
+		if err != nil {
+			t.Fatal(err)
+		}
+		received = append(received, fd)
+		addr, ok := ln.takeRemoteAddr(fd)
+		if !ok || addr.(*net.TCPAddr).Port != i {
+			t.Fatalf("wrong address for connection %d: %v", i, addr)
+		}
+		var payload [1]byte
+		if n, err := syscall.Read(fd, payload[:]); err != nil || n != 1 || payload[0] != byte(i) {
+			t.Fatalf("connection %d payload = %v (n=%d, err=%v)", i, payload, n, err)
+		}
+	}
+}
+
+func TestAcceptRejectsIncompleteAndUnknownTransfers(t *testing.T) {
+	for _, truncated := range []bool{false, true} {
+		t.Run(fmt.Sprint("truncated=", truncated), func(t *testing.T) {
+			control := testSocketPair(t)
+			conn := testSocketPair(t)
+			ln := &listener{}
+			payload := make([]byte, 8)
+			if truncated {
+				payload = payload[:1]
+			}
+			if err := syscall.Sendmsg(control[1], payload, syscall.UnixRights(conn[0]), nil, 0); err != nil {
+				t.Fatal(err)
+			}
+			if err := syscall.Shutdown(control[1], syscall.SHUT_WR); err != nil {
+				t.Fatal(err)
+			}
+			fd, err := ln.acceptConn(control[0])
+			if err == nil {
+				syscall.Close(fd)
+				t.Fatal("invalid transfer accepted")
+			}
+			if truncated && err != io.ErrUnexpectedEOF {
+				t.Fatalf("got %v, want unexpected EOF", err)
+			}
+			if len(ln.m) != 0 {
+				t.Fatal("invalid transfer created an authenticated address")
+			}
+		})
+	}
+}
