+// clientLogSwitches replaces the process-wide client-log switches for one
+// test, because the real ones cannot be undone within the process, and
+// counts how often they are thrown. It restores the switches and the
+// record after the test.
+func clientLogSwitches(t *testing.T) *atomic.Int32 {
+	t.Helper()
+	if envknob.NoLogsNoSupport() {
+		t.Skip("TS_NO_LOGS_NO_SUPPORT is set, so client log upload is off before the test starts")
+	}
+	var thrown atomic.Int32
+	switches := disableClientLogUpload
+	disableClientLogUpload = func() { thrown.Add(1) }
+	setClientLogsOff(false)
+	t.Cleanup(func() {
+		disableClientLogUpload = switches
+		setClientLogsOff(false)
+	})
+	return &thrown
+}
+
+func setClientLogsOff(off bool) {
+	clientLogs.mu.Lock()
+	defer clientLogs.mu.Unlock()
+	clientLogs.off = off
+}
+
+// TestClientLogUploadSwitch drives tailscale_set_client_log_upload from C.
+// Turning uploads off before start throws the switches once and is
+// reported, asking for uploads again cannot undo it, and a started server
+// is refused.
+func TestClientLogUploadSwitch(t *testing.T) {
+	thrown := clientLogSwitches(t)
+	tsnetctest.RunTestClientLogUpload(t)
+	if got := thrown.Load(); got != 1 {
+		t.Fatalf("client log switches thrown %d times, want 1", got)
+	}
+}
+
+// clientLogChildEnv marks the child process that
+// TestClientLogUploadOffStopsLogtail throws the real switches in.
+const clientLogChildEnv = "LIBTAILSCALE_TEST_CLIENT_LOG_CHILD"
+
+type roundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f roundTripFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+// TestClientLogUploadOffStopsLogtail throws the real switches, so it runs in
+// a child process: they cannot be undone. tsnet starts no log uploader in a
+// test binary, so the test drives a logtail.Logger directly, through a
+// transport that counts requests. Before the switch a log line reaches the
+// transport; after it, nothing does, and logpolicy's knob for its log
+// transport is set.
+func TestClientLogUploadOffStopsLogtail(t *testing.T) {
+	if os.Getenv(clientLogChildEnv) != "1" {
+		if envknob.NoLogsNoSupport() {
+			t.Skip("TS_NO_LOGS_NO_SUPPORT is set, so client log upload is off before the test starts")
+		}
+		cmd := exec.Command(os.Args[0], "-test.run=^TestClientLogUploadOffStopsLogtail$", "-test.count=1")
+		cmd.Env = append(os.Environ(), clientLogChildEnv+"=1")
+		if out, err := cmd.CombinedOutput(); err != nil {
+			t.Fatalf("child process: %v\n%s", err, out)
+		}
+		return
+	}
+
+	var requests atomic.Int32
+	transport := roundTripFunc(func(r *http.Request) (*http.Response, error) {
+		if r.Body != nil {
+			r.Body.Close()
+		}
+		requests.Add(1)
+		return &http.Response{StatusCode: http.StatusOK, Body: http.NoBody, Request: r}, nil
+	})
+	newLogger := func() *logtail.Logger {
+		return logtail.NewLogger(logtail.Config{
+			Collection:   logtail.CollectionNode,
+			BaseURL:      "http://logtail.invalid",
+			HTTPC:        &http.Client{Transport: transport},
+			Stderr:       io.Discard,
+			FlushDelayFn: func() time.Duration { return 0 },
+		}, t.Logf)
+	}
+	shutdown := func(lg *logtail.Logger) {
+		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		lg.Shutdown(ctx)
+	}
+
+	before := newLogger()
+	before.Logf("a line before the switch")
+	deadline := time.Now().Add(10 * time.Second)
+	for requests.Load() == 0 && time.Now().Before(deadline) {
+		time.Sleep(10 * time.Millisecond)
+	}
+	shutdown(before)
+	if requests.Load() == 0 {
+		t.Fatal("logtail sent nothing before the switch, so this test cannot see an upload")
+	}
+
+	sd := TsnetNewServer()
+	defer TsnetClose(sd)
+	if rc := TsnetSetClientLogUpload(sd, 0); rc != 0 {
+		t.Fatalf("TsnetSetClientLogUpload(off) = %d, want 0", rc)
+	}
+	if TsnetClientLogUpload() != 0 {
+		t.Fatal("client log upload is still reported on after the switch")
+	}
+	if !envknob.NoLogsNoSupport() {
+		t.Fatal("TS_NO_LOGS_NO_SUPPORT is not set after the switch, so logpolicy's log transport stays live")
+	}
+
+	sent := requests.Load()
+	after := newLogger()
+	after.Logf("a line after the switch")
+	time.Sleep(500 * time.Millisecond)
+	shutdown(after)
+	if got := requests.Load() - sent; got != 0 {
+		t.Fatalf("logtail sent %d requests after the switch, want 0", got)
+	}
+}
