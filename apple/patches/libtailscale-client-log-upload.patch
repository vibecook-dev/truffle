+// clientLogs records whether this process turned off the upload of its
+// Tailscale client logs. Like the switches it records, it is process-wide
+// and lasts for the life of the process.
+var clientLogs struct {
+	mu  sync.Mutex
+	off bool
+}
+
+// disableClientLogUpload throws the two process-wide switches the control
+// server's DisableLogTail throws: logtail.Disable stops every upload, and
+// envknob.SetNoLogsNoSupport, which tailscaled's --no-logs-no-support sets,
+// turns logpolicy's log transport into a no-op and tells the control server
+// through Hostinfo. Neither can be undone within the process, so tests
+// replace this.
+var disableClientLogUpload = func() {
+	logtail.Disable()
+	envknob.SetNoLogsNoSupport()
+}
+
+// TsnetSetClientLogUpload turns the upload of client logs to Tailscale off
+// (enabled == 0) or leaves it on. tsnet's own logger has no option for it:
+// it skips the upload only in a test binary. Turning it off is process-wide
+// and one-way, and must come before the server starts, since a started
+// server may already have uploaded.
+//
+//export TsnetSetClientLogUpload
+func TsnetSetClientLogUpload(sd C.int, enabled C.int) C.int {
+	s := getServer(sd)
+	if s == nil {
+		return C.EBADF
+	}
+	if enabled != 0 {
+		// Uploads are on unless this process turned them off, which
+		// cannot be undone: there is nothing to do.
+		return s.recErr(nil)
+	}
+	if s.started {
+		return s.recErr(fmt.Errorf("libtailscale: client log upload must be turned off before the server starts"))
+	}
+	clientLogs.mu.Lock()
+	defer clientLogs.mu.Unlock()
+	if !clientLogs.off {
+		disableClientLogUpload()
+		clientLogs.off = true
+	}
+	return s.recErr(nil)
+}
+
+// TsnetClientLogUpload reports whether this process uploads its client logs
+// to Tailscale: 1 until the upload is turned off, by
+// TsnetSetClientLogUpload or by TS_NO_LOGS_NO_SUPPORT, and 0 after.
+//
+//export TsnetClientLogUpload
+func TsnetClientLogUpload() C.int {
+	clientLogs.mu.Lock()
+	off := clientLogs.off
+	clientLogs.mu.Unlock()
+	if off || envknob.NoLogsNoSupport() {
+		return 0
+	}
+	return 1
+}
+
