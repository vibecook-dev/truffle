+// RunTestClientLogUpload runs the C-side test_client_log_upload. The caller
+// replaces the process-wide client-log switches first: they cannot be undone
+// within the process.
+func RunTestClientLogUpload(t *testing.T) {
+	// Corp#4520: don't use netns for tests.
+	netns.SetEnabled(false)
+	t.Cleanup(func() {
+		netns.SetEnabled(true)
+	})
+
+	derpLogf := logger.Discard
+	if *verboseDERP {
+		derpLogf = t.Logf
+	}
+	derpMap := integration.RunDERPAndSTUN(t, derpLogf, "127.0.0.1")
+	control := &testcontrol.Server{
+		DERPMap: derpMap,
+	}
+	control.HTTPTestServer = httptest.NewUnstartedServer(control)
+	control.HTTPTestServer.Start()
+	t.Cleanup(control.HTTPTestServer.Close)
+	t.Logf("testcontrol listening on %s", control.HTTPTestServer.URL)
+
+	C.control_url = C.CString(control.HTTPTestServer.URL)
+	C.tmpsl = C.CString(t.TempDir())
+
+	if C.test_client_log_upload() != 0 {
+		t.Fatal(C.GoString(C.err))
+	}
+}
