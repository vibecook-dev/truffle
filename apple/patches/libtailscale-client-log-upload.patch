+// test_client_log_upload drives tailscale_set_client_log_upload. Uploads
+// are on until a server turns them off before it starts. Turning them off
+// is process-wide and one-way, so asking for them again changes nothing.
+// A started server is refused, because it may already have uploaded.
+int test_client_log_upload() {
+	int ret;
+	char msg[256];
+
+	if (err == NULL) {
+		err = calloc(errlen, 1);
+	}
+
+	if ((ret = tailscale_client_log_upload()) != 1) {
+		snprintf(err, errlen, "client log upload before any switch = %d, want 1", ret);
+		return 1;
+	}
+	if ((ret = tailscale_set_client_log_upload(-1, 0)) != EBADF) {
+		snprintf(err, errlen, "switch on an invalid server = %d, want EBADF", ret);
+		return 1;
+	}
+
+	sl = tailscale_new();
+	if (tailscale_set_control_url(sl, control_url) != 0) {
+		return set_err(sl, 'h');
+	}
+	if (tailscale_set_dir(sl, tmpsl) != 0) {
+		return set_err(sl, 'i');
+	}
+	if (tailscale_set_logfd(sl, -1) != 0) {
+		return set_err(sl, 'j');
+	}
+
+	// Asking for the default changes nothing.
+	if (tailscale_set_client_log_upload(sl, 1) != 0) {
+		return set_err(sl, 'k');
+	}
+	if ((ret = tailscale_client_log_upload()) != 1) {
+		snprintf(err, errlen, "client log upload after asking for it = %d, want 1", ret);
+		return 1;
+	}
+
+	if (tailscale_set_client_log_upload(sl, 0) != 0) {
+		return set_err(sl, 'l');
+	}
+	if ((ret = tailscale_client_log_upload()) != 0) {
+		snprintf(err, errlen, "client log upload after turning it off = %d, want 0", ret);
+		return 1;
+	}
+
+	// One-way: asking for uploads again succeeds and leaves them off, and
+	// turning them off a second time is not an error.
+	if (tailscale_set_client_log_upload(sl, 1) != 0) {
+		return set_err(sl, 'm');
+	}
+	if (tailscale_set_client_log_upload(sl, 0) != 0) {
+		return set_err(sl, 'n');
+	}
+	if ((ret = tailscale_client_log_upload()) != 0) {
+		snprintf(err, errlen, "client log upload after asking for it again = %d, want 0", ret);
+		return 1;
+	}
+
+	if (tailscale_start(sl) != 0) {
+		return set_err(sl, 'o');
+	}
+	if ((ret = tailscale_set_client_log_upload(sl, 0)) != -1) {
+		snprintf(err, errlen, "switch after start = %d, want -1", ret);
+		return 1;
+	}
+	msg[0] = '\0';
+	tailscale_errmsg(sl, msg, sizeof msg);
+	if (strstr(msg, "before the server starts") == NULL) {
+		snprintf(err, errlen, "switch after start: errmsg %s, want it to say the switch comes before the server starts", msg);
+		return 1;
+	}
+
+	if (tailscale_close(sl) != 0) {
+		return set_err(sl, 'p');
+	}
+	return 0;
+}
